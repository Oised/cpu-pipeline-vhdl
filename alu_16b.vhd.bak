entity alu_16b is
	port(
		A       : in  std_logic_vector(15 downto 0);
		B       : in  std_logic_vector(15 downto 0);
		Control : in  std_logic;
		R       : out std_logic_vector(15 downto 0);
		Flag    : out std_logic
	);
end alu_16b;

architecture structure of alu_16b is
begin
end structure;
